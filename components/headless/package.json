{
  "name": "@wondesign/headless",
  "description": "WonDesign - Headless UI components",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "keywords": [
    "design",
    "system",
    "ui",
    "components",
    "headless",
    "no-style",
    "react",
    "typescript"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*/index.d.mts",
      "default": "./dist/*/index.mjs"
    }
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsdown",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@wondesign/focus": "workspace:*",
    "@wondesign/key-events": "workspace:*",
    "@wondesign/pointer": "workspace:*",
    "@wondesign/position": "workspace:*"
  }
}
