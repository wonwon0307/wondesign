{
  "name": "@wondesign/separator",
  "description": "WonDesign - Separator",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "keywords": [
    "design",
    "system",
    "ui",
    "components",
    "separator",
    "line",
    "react",
    "typescript"
  ],
  "author": "WonWon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wonwon0307/wondesign.git",
    "directory": "components/separator"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsdown",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vanilla-extract/recipes": "catalog:",
    "clsx": "catalog:"
  },
  "devDependencies": {
    "@vanilla-extract/css": "catalog:",
