{
  "name": "wonwon-designs",
  "version": "1.0.0",
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write --log-level warn .",
    "lint": "turbo run lint",
    "test": "vitest run",
    "test:dev": "vitest run --watch --coverage",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@tsdown/css": "^0.23.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.1",
    "turbo": "^2.11.9",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{json,md,yml,yaml}": "prettier --check",
    "*.{ts,tsx,js,jsx}": [
      "prettier --check",
      "eslint"
    ]
  }
}
