{
  "name": "@wondesign/theme",
  "description": "WonDesign - Theme",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "keywords": [
    "design",
    "theme",
    "color-scheme",
    "css",
    "light-dark",
    "react",
    "typescript"
  ],
  "author": "WonWon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wonwon0307/wondesign.git",
    "directory": "foundations/theme"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/custom/index.d.mts",
      "default": "./dist/custom/index.mjs"
    },
    "./server": {
      "types": "./dist/custom/server.d.mts",
      "default": "./dist/custom/server.mjs"
    },
    "./light-dark": {
      "types": "./dist/light-dark/index.d.mts",
      "default": "./dist/light-dark/index.mjs"
    },
    "./light-dark/server": {
      "types": "./dist/light-dark/server.d.mts",
      "default": "./dist/light-dark/server.mjs"
    }
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "react-dom": "^19.3.1"
  }
}
