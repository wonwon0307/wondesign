{
  "name": "@wondesign/svg2tsx",
  "description": "Wondesign - SVG2TSX (Icon Converter)",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "keywords": [
    "svg",
    "convert",
    "icons",
    "react",
    "typescript"
  ],
  "author": "WonWon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wonwon0307/wondesign.git",
    "directory": "foundations/svg2tsx"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "bin": {
    "svg2tsx": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsdown",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3"
  }
}
