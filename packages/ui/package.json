{
  "name": "@wondesign/ui",
  "description": "WonDesign - Design System UI components",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "keywords": [
    "design-system",
    "ui",
    "reset-css",
    "react",
    "typescript"
  ],
  "exports": {
    "./styles.css": "./dist/styles.css",
    "./*": {
      "types": "./dist/entries/*.d.mts",
      "default": "./dist/entries/*.mjs"
    }
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@wondesign/alert": "workspace:*",
    "@wondesign/buttons": "workspace:*",
    "@wondesign/code": "workspace:*",
    "@wondesign/disclosure": "workspace:*",
    "@wondesign/focus": "workspace:*",
    "@wondesign/headless": "workspace:*",
    "@wondesign/icons": "workspace:*",
    "@wondesign/key-events": "workspace:*",
    "@wondesign/links": "workspace:*",
    "@wondesign/loading": "workspace:*",
    "@wondesign/navbar": "workspace:*",
    "@wondesign/pointer": "workspace:*",
    "@wondesign/position": "workspace:*",
    "@wondesign/separators": "workspace:*",
    "@wondesign/sidebar": "workspace:*",
    "@wondesign/tabs": "workspace:*",
    "@wondesign/texts": "workspace:*",
    "@wondesign/theme": "workspace:*",
    "@wondesign/toast": "workspace:*",
    "@wondesign/tokens": "workspace:*",
    "@wondesign/tooltip": "workspace:*"
  },
  "devDependencies": {
    "@wondesign/reset-css": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.2",
    "react-dom": "^19.2"
  }
}
